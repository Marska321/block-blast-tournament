# Browser settings (public; never put service credentials in VITE_ variables)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key
# Casual launch hides official entry and keeps progress local. Keep server PILOT_ENABLED=false too.
VITE_CASUAL_ONLY=true
# Optional, free daily Classic rankings; independent of prize entry.
VITE_CLASSIC_RANKED_ENABLED=false
# Optional public WhatsApp Channel; no player phone-number collection.
VITE_WHATSAPP_CHANNEL_URL=

# Server / local operator only
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
# Remains false until migrations, anonymous Auth CAPTCHA, and staging checks pass.
PILOT_ENABLED=false
CLASSIC_RANKED_ENABLED=false
# Mark staging rankings/results cards clearly as test data.
CLASSIC_DEMO=false
# Operator's WhatsApp destination: international digits only, no + or spaces.
# Leave empty to disable claims. This is a destination, not an API credential.
TOURNAMENT_WHATSAPP_NUMBER=

# Optional announcements + device notifications (server only; independent of prizes/rankings).
UPDATES_ENABLED=false
UPDATES_ORIGINS=https://blokblaster.vercel.app,https://block-blast-tournament.vercel.app
# Generate once with npm run push:keys. Only the public key is returned by the API.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=https://blokblaster.vercel.app
# Random server secret of at least 32 characters for the protected daily dispatcher.
CRON_SECRET=
